{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "evening edition data",
  "type": "object",
  "required": ["date", "edition", "filings", "usdjpy", "jgb", "reference", "notes"],
  "$defs": {"day": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
            "count": {"type": "integer", "minimum": 0}},
  "properties": {
    "date": {"$ref": "#/$defs/day"},
    "edition": {"enum": ["morning", "evening", "weekly"]},
    "period": {"type": "object", "required": ["kind", "start", "end", "days"]},
    "filings": {
      "type": "object",
      "required": ["date", "total", "daily", "by_type", "large_holdings", "extraordinary", "tender_offers", "buybacks"],
      "properties": {
        "date": {"$ref": "#/$defs/day"},
        "total": {"type": "integer", "minimum": 1},
        "by_type": {"type": "array", "minItems": 1,
                    "items": {"type": "object", "required": ["code", "name", "count"]}},
        "large_holdings": {
          "type": "object", "required": ["count", "listed_count", "listed_new_count", "listed_change_count", "detail_count", "top_issuers", "items"],
          "properties": {"items": {"type": "array", "items": {
            "type": "object", "required": ["issuer", "sec_code", "kind", "filer", "ratio_pct", "prev_ratio_pct", "change_pt", "direction"]}}}
        },
        "extraordinary": {
          "type": "object", "required": ["count", "listed_count", "by_reason", "items"],
          "properties": {"items": {"type": "array", "items": {
            "type": "object", "required": ["filer", "sec_code", "reasons"]}}}
        },
        "tender_offers": {"type": "object", "required": ["count", "items"]},
        "buybacks": {"type": "object", "required": ["count"]}
      }
    },
    "usdjpy": {"type": "object",
               "required": ["date", "close", "change", "change_pct", "direction", "period_high", "period_low", "history"]},
    "jgb": {
      "type": "object", "required": ["date", "yields"],
      "properties": {"yields": {"type": "array", "minItems": 1, "items": {
        "type": "object", "required": ["tenor", "yield_pct", "prev_pct", "change_pt"]}}}
    },
    "reference": {"type": "object"},
    "notes": {"type": "array", "items": {"type": "string"}}
  }
}
