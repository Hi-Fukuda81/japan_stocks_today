{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "evening disclosure script",
  "type": "object",
  "required": ["date", "title", "description_summary", "scenes"],
  "additionalProperties": false,
  "properties": {
    "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "description": "data.json の date と同じ"},
    "title": {"type": "string", "minLength": 1, "maxLength": 100, "pattern": "^きょうの日本株【(朝|夕|週間まとめ)】"},
    "description_summary": {"type": "string", "minLength": 1},
    "scenes": {
      "type": "array",
      "minItems": 7, "maxItems": 7,
      "items": {
        "type": "object",
        "required": ["id", "visual", "lines"],
        "additionalProperties": false,
        "properties": {
          "id": {"enum": ["01_opening", "02_tender", "03_holdings", "04_events", "05_usdjpy", "06_jgb", "07_ending"]},
          "visual": {"enum": ["title", "tender_offers", "holdings_table", "events_list", "usdjpy_line", "jgb_yields", "ending"]},
          "lines": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1, "maxLength": 45}}
        }
      }
    }
  },
  "x-scene-order": [
    ["01_opening", "title"],
    ["02_tender", "tender_offers"],
    ["03_holdings", "holdings_table"],
    ["04_events", "events_list"],
    ["05_usdjpy", "usdjpy_line"],
    ["06_jgb", "jgb_yields"],
    ["07_ending", "ending"]
  ]
}
